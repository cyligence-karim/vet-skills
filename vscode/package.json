{
  "name": "killerskills",
  "displayName": "KillerSkills: MCP and agent skill verdicts",
  "description": "Security verdicts for every MCP server and agent skill in your config files, inline. Flags credential values pasted into .mcp.json, Cursor and Claude Desktop configs. Works in VS Code, Cursor and Windsurf.",
  "version": "0.1.0",
  "publisher": "cyligence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyligence-karim/vet-skills",
    "directory": "vscode"
  },
  "homepage": "https://killerskills.ai",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "mcp",
    "claude",
    "cursor",
    "agent",
    "security",
    "skills"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:toml",
    "onLanguage:markdown",
    "workspaceContains:**/.mcp.json",
    "workspaceContains:**/.cursor/mcp.json",
    "workspaceContains:**/.claude/settings.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "killerskills.checkFile",
        "title": "KillerSkills: Check this config"
      },
      {
        "command": "killerskills.openBenchmarks",
        "title": "KillerSkills: Open MCP server benchmarks"
      }
    ],
    "configuration": {
      "title": "KillerSkills",
      "properties": {
        "killerskills.apiBase": {
          "type": "string",
          "default": "https://killerskills.ai",
          "description": "KillerSkills API base URL (self-hosted verdict cache for Enterprise)."
        },
        "killerskills.flagUnvetted": {
          "type": "boolean",
          "default": true,
          "description": "Show an information diagnostic for servers and skills that have no verdict yet."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --target=node18 --outfile=dist/extension.js",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
